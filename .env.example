# ResearchHub MBA V1.0 Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Application host and port
APP_HOST=127.0.0.1
APP_PORT=8501

# Storage and Data Roots (relative to project root by default)
DATA_DIR=data
STORAGE_DIR=data/storage
DATABASE_PATH=data/researchhub.sqlite

# Logging
LOG_LEVEL=INFO
