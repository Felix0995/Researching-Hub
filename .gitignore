# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Local Application Data, Databases & User Files (CRITICAL: NEVER COMMIT)
data/
storage/
backups/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Research source files & user docs (safety safeguard)
*.pdf
*.docx
*.xlsx
*.csv
!tests/fixtures/*.pdf
!tests/fixtures/*.docx

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editor & IDE directories
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Local logs
*.log
